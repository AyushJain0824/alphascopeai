# OpenRouter — AI Assistant (free tier / credits at https://openrouter.ai/)
# Copy to `.env` next to package.json, add your key, restart `npm run dev`
VITE_OPENROUTER_API_KEY=

# Optional — rss2json.com higher rate limits (free tier at https://rss2json.com)
# VITE_RSS2JSON_API_KEY=

# Market data: no key needed (Yahoo via Vite proxy).
# Optional — Firebase Google Sign-In (see src/config/firebaseAuth.config.js)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
